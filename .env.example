# Скопируйте этот файл в .env и заполните значения.
# Файл .env не коммитится.

# --- TELEGRAM_BOT_TOKEN ---
# Токен бота от @BotFather. В репозиторий не класть.
TELEGRAM_BOT_TOKEN=

# --- CHAT_ID ---
# Числовой id чата, куда отправлять дайджест.
CHAT_ID=

# --- HH_QUERIES ---
# Поисковые фразы для api.hh.ru через запятую.
# Каждый элемент уходит отдельным GET с schedule=remote.
HH_QUERIES=python aiogram,python fastapi,python django

# --- TG_CHANNELS ---
# Имена публичных каналов без https://t.me/, через запятую.
TG_CHANNELS=job_python,young_june,juniors_rabota_jobs,it_vakansii_jobs,forpython,geekjobs,jobforjunior,jobs_juniors_remote

# --- HABR_RSS ---
# Рабочий адрес ленты: путь vacancies/rss (вариант vacancies.rss отвечает 404).
HABR_RSS=https://career.habr.com/vacancies/rss?remote=true&q=python
