# Скопируйте в .env и подставьте свои значения.
# .env создаёт только владелец вручную. В git он не попадает.

# ==========================================
# TELEGRAM CONFIGURATION
# ==========================================
# Токен бота. Получите его у @BotFather командой /newbot.
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Числовой id чата, куда слать дайджест.
# Узнайте свой Chat ID через @userinfobot.
CHAT_ID=YOUR_CHAT_ID_HERE

# ==========================================
# HH.RU API
# ==========================================
# Фразы для api.hh.ru через запятую.
# Каждая уходит отдельным GET с schedule=remote.
HH_QUERIES=python aiogram,python fastapi,python django

# ==========================================
# TELEGRAM CHANNELS
# ==========================================
# Список каналов указывать через запятую без символа @ и без https://t.me/.
TG_CHANNELS=job_python,young_june,juniors_rabota_jobs,it_vakansii_jobs,forpython,geekjobs,jobforjunior,jobs_juniors_remote

# ==========================================
# HABR CAREER RSS
# ==========================================
# Рабочий адрес ленты. Путь vacancies/rss; вариант vacancies.rss отвечает 404.
HABR_RSS=https://career.habr.com/vacancies/rss?remote=true&q=python

# ==========================================
# ПРОФИЛЬ ДЛЯ /letter
# ==========================================
# Пустое значение — берётся нейтральная заглушка из config.py.
# Числа в письме разрешены только из этих полей и из зарплаты вакансии.
PROFILE_YEARS=
PROFILE_STACK=
# Свои ссылки через запятую, они разрешены в письме автоматически.
PROFILE_LINKS=
# Префиксы разрешённых ссылок через запятую. По умолчанию https://github.com/kartuznik.
WHITELIST_LINKS=
