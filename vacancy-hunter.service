[Unit]
Description=Vacancy hunter bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/bots/vacancy-hunter
ExecStart=/opt/bots/vacancy-hunter/.venv/bin/python /opt/bots/vacancy-hunter/bot.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
